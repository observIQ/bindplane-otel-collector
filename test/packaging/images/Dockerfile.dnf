# systemd-enabled image for dnf based distros, used by the packaging test
# suite. BASE_IMAGE is passed by the suite from the distro matrix in
# distros_test.go. The image is built with the classic builder, so BuildKit
# only syntax (RUN --mount, heredocs) must not be used.
ARG BASE_IMAGE=rockylinux/rockylinux:10
FROM ${BASE_IMAGE}

ENV container=docker

RUN dnf -y --setopt=install_weak_deps=False install \
        systemd \
        procps-ng \
        shadow-utils \
        util-linux-core \
        findutils \
    && dnf clean all

# Mask units that do not work, or are not useful, inside a container. The
# package scripts are tested against the default multi-user target.
RUN systemctl mask \
        getty.target \
        console-getty.service \
        systemd-firstboot.service \
        systemd-udevd.service \
        systemd-udevd-control.socket \
        systemd-udevd-kernel.socket \
        systemd-modules-load.service \
        sys-kernel-config.mount \
        sys-kernel-debug.mount \
        sys-kernel-tracing.mount \
    && systemctl set-default multi-user.target \
    && mkdir -p /pkgtest \
    && test -x /sbin/nologin \
    && command -v useradd \
    && command -v getent

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
